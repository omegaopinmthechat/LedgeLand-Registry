# Server Configuration
PORT=*port number*

# Supabase Configuration
SUPABASE_URL=*YOUR SUPABASE URL*
SUPABASE_SECRET=*YOUR SUPABASE SECRET KEY*
SUPABASE_PUBLISHABLE=*YOUR PUBLISHABLE KEY*

# IPFS Configuration
# Pinata JWT token for file uploads (get from https://pinata.cloud/)
PINATA_JWT=*Your Pinata JWT token*

# Alchemy / Ethereum Configuration
# Alchemy API key (used by backend provider). Sign up at https://www.alchemy.com/
ALCHEMY_API_KEY=*Your Alchemy API Key*

# Private key of the backend wallet used to sign transactions
# WARNING: keep this secret and never commit the real key to source control.
PRIVATE_KEY=*Your wallet private key*

# Deployed LandRegistry contract address
CONTRACT_ADDRESS=*YourContractAddress*

# Network name (e.g., sepolia, mainnet)
NETWORK=sepolia